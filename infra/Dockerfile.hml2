# Base python image
FROM python:3.11-alpine AS python-base

ARG ENV="HOMOLOG"
ENV ENV=${ENV}

ARG TOKEN_PKG_LIB_GITHUB=""
ENV TOKEN_PKG_LIB_GITHUB=${TOKEN_PKG_LIB_GITHUB}

# Stage for Poetry installation
FROM python-base AS poetry-base

# https://python-poetry.org/docs#ci-recommendations
ARG POETRY_VERSION=2.1.3
ENV POETRY_VERSION=${POETRY_VERSION} \
    POETRY_HOME=/opt/poetry \
    POETRY_VENV=/opt/poetry-venv \
    POETRY_CACHE_DIR=/opt/.cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Installing Poetry and dependencies
RUN python3 -m venv $POETRY_VENV \
    && $POETRY_VENV/bin/pip install -U pip setuptools \
    && $POETRY_VENV/bin/pip install poetry==${POETRY_VERSION}

RUN apk add --no-cache curl git gcc musl-dev libffi-dev build-base jq bash python3-dev linux-headers

# Add Poetry to PATH
ENV PATH=$POETRY_VENV/bin:$PATH

# Add arcs-lib-pca, 
# Caso de algum erro para clonar o arcs-lib-pca, 
# certifique-se que o TOKEN_PKG_LIB_GITHUB no Environment da oganization Danylo93 no github, não expirou.
# Caso tenha expirado gere um novo e atualize no Environment
WORKDIR /arcs-lib-pca
RUN git clone https://${TOKEN_PKG_LIB_GITHUB}@github.com/Danylo93/arcs-lib-pca.git . \
    && git checkout main \
    && poetry build

WORKDIR /app

# Copy project files
COPY ./alembic ./alembic
COPY ./infra/arcs.sh ./infra/arcs.sh
RUN chmod +x ./infra/arcs.sh
COPY ./src ./src
COPY ./__init__.py ./
COPY ./alembic.ini ./
#o arquivo .env é criado durante o build no github actions
COPY ./.env ./.env
COPY ./main.py ./
COPY ./pyproject.toml ./
COPY ./README.md ./

# Install dependencies for hml2 environment
RUN poetry install --with hml2 --without dev --no-interaction

# Validate the project setup
RUN poetry check \
    && poetry completions bash >> ~/.bash_completion \
    && poetry --version \
    # Clear cache to reduce image size
    && poetry cache clear --all pypi

# Add security certificates and openssl (needed to generate pub-arcs.pem from priv-arcs.pem)
RUN apk add --no-cache ca-certificates openssl
# Create /app/keys directory (required by arcs_lib_pca)
RUN mkdir -p /app/keys

# Create startup script to write priv-arcs.pem from secret and generate pub-arcs.pem
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'mkdir -p /app/keys' >> /app/start.sh && \
    echo 'if [ -n "$PRIV_ARCS_PEM" ]; then' >> /app/start.sh && \
    echo '  echo "$PRIV_ARCS_PEM" > /app/keys/priv-arcs.pem' >> /app/start.sh && \
    echo '  chmod 600 /app/keys/priv-arcs.pem' >> /app/start.sh && \
    echo '  echo "✅ priv-arcs.pem criado a partir do secret"' >> /app/start.sh && \
    echo '  # Gerar pub-arcs.pem a partir de priv-arcs.pem' >> /app/start.sh && \
    echo '  if openssl rsa -in /app/keys/priv-arcs.pem -pubout -out /app/keys/pub-arcs.pem 2>/dev/null; then' >> /app/start.sh && \
    echo '    chmod 644 /app/keys/pub-arcs.pem' >> /app/start.sh && \
    echo '    echo "✅ pub-arcs.pem gerado a partir de priv-arcs.pem"' >> /app/start.sh && \
    echo '  else' >> /app/start.sh && \
    echo '    echo "⚠️  Falha ao gerar pub-arcs.pem, tentando com formato diferente..."' >> /app/start.sh && \
    echo '    # Tentar com formato diferente (algumas chaves podem ser ECDSA ou outros formatos)' >> /app/start.sh && \
    echo '    openssl pkey -in /app/keys/priv-arcs.pem -pubout -out /app/keys/pub-arcs.pem 2>/dev/null && chmod 644 /app/keys/pub-arcs.pem && echo "✅ pub-arcs.pem gerado (formato alternativo)" || echo "❌ Falha ao gerar pub-arcs.pem"' >> /app/start.sh && \
    echo '  fi' >> /app/start.sh && \
    echo 'else' >> /app/start.sh && \
    echo '  echo "⚠️  PRIV_ARCS_PEM não está definido"' >> /app/start.sh && \
    echo 'fi' >> /app/start.sh && \
    echo 'exec poetry run gunicorn -w 4 --bind 0.0.0.0:8000 main:wsgi_app' >> /app/start.sh && \
    chmod +x /app/start.sh

# Create a non-root user and set permissions for /app
RUN adduser -u 5678 --disabled-password --gecos "" appuser && chown -R appuser /app

# Switch to the non-root user
USER appuser

# Expose port 8000
EXPOSE 8000

# Set the entrypoint
ENTRYPOINT ["/app/start.sh"]